pipeline {
    agent {
        docker {
            image 'kuklev/builder:0.0.1'
            args '-v gradle-cache:/tmp/gradle-home'
        }
    }

    stages {
        stage('Diagnostics') {
            steps {
                sh '''
                    id
                    echo "HOME=$HOME"
                    echo "GRADLE_USER_HOME=$GRADLE_USER_HOME"
                    ls -ld /tmp/gradle-home
                '''
            }
        }
        stage('Build') {
            steps {
                sh 'bash ./gradlew :monolith:bootJar --no-daemon'
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'monolith/build/libs/*.jar',
                             fingerprint: true
        }
    }
}
